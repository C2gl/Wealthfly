# Firefly III connection
FIREFLY_URL=https://firefly.example.com
FIREFLY_TOKEN=replace-with-a-firefly-personal-access-token

# Wealthfly server
PORT=4400
SYNC_CRON=0 */6 * * *

# The very first sync is always a full historical sync. Every sync after that
# only re-fetches and re-applies this many trailing days, instead of your
# entire history — much faster once you have a lot of transactions. This
# window also re-checks recent transactions for edits/backdating, so it
# should be wide enough to cover how far back you (or a bank import) typically
# correct or backdate a transaction. Anything edited further back than this
# won't be picked up until the next full resync (POST /api/sync?full=true).
SYNC_LOOKBACK_DAYS=30

# Dashboard language (available catalogs: en, fr)
WEALTHFLY_LANGUAGE=en

# Comma-separated words used to identify savings accounts by name
RECURENT_WORD_IN_SAVING_ACCOUNTS=saving, epargne, épargne

# Docker image tag (use dev to test a non-main branch image)
# WEALTHFLY_IMAGE_TAG=latest

# --- Authentication (recommended) ---
# Without this, Wealthfly has NO LOGIN — anyone who can reach the port sees your data.
# WEALTHFLY_PASSWORD=choose-a-strong-password
# Random secret used to sign the session cookie. Required once the line above is set.
# Generate one with: openssl rand -hex 32
# WEALTHFLY_SESSION_SECRET=

# Optional local database location
# DB_PATH=./backend/data/wealthfly.db